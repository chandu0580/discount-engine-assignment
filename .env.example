# Copy to .env.local and fill in. Only needed for plain-English rules (Task 2).
# Server-side only: not VITE_-prefixed, so never bundled into the browser code.
# Set ONE provider. If both are set, Anthropic is used.

# Option A: Anthropic API
ANTHROPIC_API_KEY=

# Option B: OpenAI or any OpenAI-compatible gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
